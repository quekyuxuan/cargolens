# Copy to .env.local for local dev. Never commit the real file.

# Server-side only: used by /api/vision so the key never reaches the browser.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Optional. Folder holding the organizer bundle so /api/files can open originals.
# Defaults to ~/Downloads/sdoc-hackathon-bundle.
SDOC_DATA=
